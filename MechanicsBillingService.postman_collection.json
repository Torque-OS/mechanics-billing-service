{
  "info": {
    "name": "Mechanics Billing Service API (Fase 4)",
    "description": "API collection for the Billing Service microservice (Budgets & Mercado Pago Payments) — FIAP POS Tech 15SOAT Fase 4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "serviceOrderId", "value": "11111111-1111-1111-1111-111111111111", "type": "string" },
    { "key": "customerId", "value": "22222222-2222-2222-2222-222222222222", "type": "string" },
    { "key": "budgetId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Budgets",
      "item": [
        {
          "name": "Generate Budget",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('budgetId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceOrderId\": \"{{serviceOrderId}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    {\n      \"type\": \"Service\",\n      \"referenceId\": \"33333333-3333-3333-3333-333333333333\",\n      \"description\": \"Troca de Óleo\",\n      \"unitPriceInCents\": 15000,\n      \"quantity\": 1\n    },\n    {\n      \"type\": \"Part\",\n      \"referenceId\": \"44444444-4444-4444-4444-444444444444\",\n      \"description\": \"Filtro de Óleo\",\n      \"unitPriceInCents\": 4500,\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/budgets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "budgets"]
            }
          }
        },
        {
          "name": "Get Budget by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/budgets/{{budgetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "budgets", "{{budgetId}}"]
            }
          }
        },
        {
          "name": "Get Budget by Service Order ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/budgets?serviceOrderId={{serviceOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "budgets"],
              "query": [{ "key": "serviceOrderId", "value": "{{serviceOrderId}}" }]
            }
          }
        },
        {
          "name": "Approve or Reject Budget",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/budgets/{{budgetId}}/decision",
              "host": ["{{baseUrl}}"],
              "path": ["api", "budgets", "{{budgetId}}", "decision"]
            }
          }
        },
        {
          "name": "Cancel Budget (Staff / Compensation)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/budgets/{{budgetId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "budgets", "{{budgetId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments (Mercado Pago)",
      "item": [
        {
          "name": "Start Payment (Generate Dynamic QR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('paymentId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"budgetId\": \"{{budgetId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"]
            }
          }
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "{{paymentId}}"]
            }
          }
        },
        {
          "name": "Get Payment QR Image (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/qr.png",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "{{paymentId}}", "qr.png"]
            }
          }
        },
        {
          "name": "Verify Payment Status on Mercado Pago",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "{{paymentId}}", "verify"]
            }
          }
        },
        {
          "name": "Mercado Pago Webhook Notification (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-signature", "value": "ts=1700000000,v1=replace_with_hmac" },
              { "key": "x-request-id", "value": "req-123" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"order.processed\",\n  \"type\": \"order\",\n  \"data\": {\n    \"id\": \"ORD01J0000000000000000000\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhooks/mercadopago",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "webhooks", "mercadopago"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
}
