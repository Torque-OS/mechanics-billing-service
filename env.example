# Copy to .env (gitignored) and fill in. docker compose reads .env automatically.
# Mercado Pago sandbox — "Your integrations" > your application:
#   Test credentials > Access Token (starts with APP_USR, test mode)
#   Webhooks > topic "Order (Mercado Pago)" > secret signature
# External POS id: printed by scripts/setup-mercadopago-sandbox.sh (store + POS creation).

MERCADOPAGO_ACCESS_TOKEN=<your-test-access-token>
MERCADOPAGO_WEBHOOK_SECRET=<your-webhook-secret-signature>
MERCADOPAGO_EXTERNAL_POS_ID=TORQUEOSPOS001
